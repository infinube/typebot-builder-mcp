TYPEBOT_API_URL=https://builder.example.com/api
TYPEBOT_API_TOKEN=replace-with-independent-typebot-api-token
# TYPEBOT_API_TOKEN_FILE=/run/secrets/typebot-token
# TYPEBOT_WORKSPACE_ID=
MCP_TRANSPORT=streamable-http
MCP_AUTH_MODE=bearer
MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters
# MCP_BEARER_TOKEN_FILE=/run/secrets/mcp-token
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=
SNAPSHOT_MODE=filesystem
SNAPSHOT_DIR=/data/snapshots
SNAPSHOT_FAILURE_POLICY=abort
SNAPSHOT_WEBHOOK_FAILURE_POLICY=abort
# SNAPSHOT_WEBHOOK_URL=https://receiver.example.com/snapshots
# SNAPSHOT_WEBHOOK_TOKEN=independent-receiver-bearer
SNAPSHOT_WEBHOOK_ALLOW_PRIVATE=false
REQUEST_TIMEOUT_MS=15000
MAX_RESPONSE_BYTES=8388608
# OAUTH_ISSUER=https://authorization.example.com
# OAUTH_JWKS_URL=https://authorization.example.com/.well-known/jwks.json
# OAUTH_RESOURCE_URL=https://mcp.example.com/mcp
OAUTH_REQUIRED_SCOPES=typebot:manage
